__pycache__/
*.pyc
*.pyo
.pytest_cache/
.coverage
coverage.xml
htmlcov/

# Build artefacts — keep data/*.zip out of this rule if needed by adding !data/*.zip
plugin.zip
terrainflow_assessment.zip

# Editor / OS artefacts
.DS_Store
Thumbs.db
*.swp
*.swo

# Nested-plugin guard (should never exist)
terrainflow_assessment/terrainflow_assessment/
plugin/plugin/

# Stray shapefiles saved to the repo ROOT (QGIS scratch layers) — root-anchored
# so real shapefiles under data/ etc. are still tracked.
/*.shp
/*.shx
/*.dbf
/*.prj
/*.cpg
/*.qpj
/*.sbn
/*.sbx

# Test-harness screenshots (tests_qgis/ Tier 2) - regenerated every run
tests_qgis/_shots/
tests_qgis/_shots_baseline/

# GDAL statistics sidecars � regenerated whenever a raster is read
*.aux.xml

# QGIS writes a style database beside whatever profile it boots with; the check
# runner boots one per module, so these appear wherever the tests were run from.
symbology-style.db
